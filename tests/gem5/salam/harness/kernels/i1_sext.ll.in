; i1 signed interpretation: sext of a true i1 is -1.
; OUT[0] = sext(IN[0] == 3); OUT[1] = sext(IN[0] == 4).

target datalayout = "e-m:e-p:32:32-Fi8-i64:64-v128:64:128-a:0:32-n32-S64"
target triple = "armv7-pc-none-eabi"

define dso_local void @top() {
  %v = load volatile i32, {PTR_I32} inttoptr (i32 {IN} to {PTR_I32}), align 4
  %t = icmp eq i32 %v, 3
  %f = icmp eq i32 %v, 4
  %st = sext i1 %t to i32
  %sf = sext i1 %f to i32
  store volatile i32 %st, {PTR_I32} inttoptr (i32 {OUT} to {PTR_I32}), align 4
  store volatile i32 %sf, {PTR_I32} inttoptr (i32 {OUT1} to {PTR_I32}), align 4
  ret void
}
