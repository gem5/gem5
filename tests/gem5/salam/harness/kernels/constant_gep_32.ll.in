; Derived from the pointer-width regression. Numeric non-inbounds constant
; GEPs fold at equal pointer/index widths; only the harness IN is dereferenced.

target datalayout = "e-p:32:32:32:32"

define void @top() {
  %index = load volatile i32, {PTR_I32} inttoptr (
      i64 {IN} to {PTR_I32})
  %input = getelementptr i32, {PTR_I32} getelementptr (
      i32, {PTR_I32} inttoptr (i64 {IN} to {PTR_I32}), i8 1),
      i32 %index
  %payload = load volatile i32, {PTR_I32} %input
  %negative = ptrtoint {PTR_I8} getelementptr (
      i8, {PTR_I8} inttoptr (i64 4096 to {PTR_I8}), i8 -1) to i64
  %c0 = icmp eq i64 %negative, 4095
  %scaled = ptrtoint {PTR_I32} getelementptr (
      i32, {PTR_I32} inttoptr (i64 4096 to {PTR_I32}), i8 -1) to i64
  %c1 = icmp eq i64 %scaled, 4092
  %nested = ptrtoint {PTR_I8} getelementptr (
      i8, {PTR_I8} getelementptr (
          i8, {PTR_I8} inttoptr (i64 4096 to {PTR_I8}), i8 -1),
      i16 9) to i64
  %c2 = icmp eq i64 %nested, 4104
  %wrapped = ptrtoint {PTR_I32} getelementptr (
      i32, {PTR_I32} inttoptr (i64 -4 to {PTR_I32}), i8 2) to i64
  %c3 = icmp eq i64 %wrapped, 4
  %high = ptrtoint {PTR_I8} getelementptr (
      i8, {PTR_I8} inttoptr (i64 4294971392 to {PTR_I8}), i8 -1) to i64
  %c4 = icmp eq i64 %high, 4095
  %underflow = ptrtoint {PTR_I8} getelementptr (
      i8, {PTR_I8} null, i8 -1) to i64
  %c5 = icmp eq i64 %underflow, 4294967295
  %ok0 = and i1 %c0, %c1
  %ok1 = and i1 %ok0, %c2
  %ok2 = and i1 %ok1, %c3
  %ok3 = and i1 %ok2, %c4
  %ok4 = and i1 %ok3, %c5
  %result = zext i1 %ok4 to i32
  store volatile i32 %payload, {PTR_I32} inttoptr (
      i64 {OUT} to {PTR_I32})
  store volatile i32 %result, {PTR_I32} inttoptr (
      i64 {OUT1} to {PTR_I32})
  ret void
}
