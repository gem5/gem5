target datalayout = "e-m:e-p:32:32-Fi8-i64:64-v128:64:128-a:0:32-n32-S64"
target triple = "armv7-pc-none-eabi"

define i32 @helper(i16 %x) {
entry:
  %wide = zext i16 %x to i32
  %y = add i32 %wide, 1
  ret i32 %y
}
define void @top() {
entry:
  %a = load volatile i32, {PTR_I32} inttoptr (i32 {IN} to {PTR_I32}), align 4
  %n = trunc i32 %a to i16
  %x = call i32 @helper(i16 %n)
  %condition = icmp eq i32 %x, 3
  %selected = select i1 %condition, i32 %x, i32 0
  store volatile i32 %selected, {PTR_I32} inttoptr (
      i32 {OUT} to {PTR_I32}), align 4
  ret void
}
define i32 @unreachable(i32 %unused) {
entry:
  %product = mul i32 %unused, 17
  ret i32 %product
}
