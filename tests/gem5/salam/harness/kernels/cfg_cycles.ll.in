; Eager unconditional cycles are unsupported. Conditional iterations return
; to the scheduler and remain valid, including when a loop is relaunched.

target datalayout = "e-m:e-p:32:32-Fi8-i64:64-v128:64:128-a:0:32-n32-S64"
target triple = "armv7-pc-none-eabi"

define void @top() {
entry:
  br label %loop
loop:
  store volatile i32 99, {PTR_I32} inttoptr (i32 {OUT} to {PTR_I32})
  br label %loop
}

define void @multi_cycle() {
entry:
  br label %first
first:
  br label %second
second:
  br label %first
}

define void @cycle_callee() {
entry:
  br label %loop
loop:
  br label %loop
}

define void @call_cycle() {
entry:
  call void @cycle_callee()
  ret void
}

define void @conditional_loop() {
entry:
  %n = load volatile i32, {PTR_I32} inttoptr (i32 {IN} to {PTR_I32})
  br label %loop
loop:
  %i = phi i32 [ 0, %entry ], [ %next, %body ]
  %continue = icmp ult i32 %i, %n
  br i1 %continue, label %body, label %exit
body:
  %next = add i32 %i, 1
  br label %loop
exit:
  store volatile i32 %i, {PTR_I32} inttoptr (i32 {OUT} to {PTR_I32})
  ret void
}
