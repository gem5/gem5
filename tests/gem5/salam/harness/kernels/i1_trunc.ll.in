; i1 representation: trunc i32 3 to i1 must hold 1, not 3.
; OUT[0] = select(trunc(IN[0]), 7, 9); OUT[1] = zext(trunc(IN[0])).

target datalayout = "e-m:e-p:32:32-Fi8-i64:64-v128:64:128-a:0:32-n32-S64"
target triple = "armv7-pc-none-eabi"

define dso_local void @top() {
  %v = load volatile i32, {PTR_I32} inttoptr (i32 {IN} to {PTR_I32}), align 4
  %b = trunc i32 %v to i1
  %s = select i1 %b, i32 7, i32 9
  store volatile i32 %s, {PTR_I32} inttoptr (i32 {OUT} to {PTR_I32}), align 4
  %z = zext i1 %b to i32
  store volatile i32 %z, {PTR_I32} inttoptr (i32 {OUT1} to {PTR_I32}), align 4
  ret void
}
