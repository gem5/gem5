target datalayout = "e-p:64:64-i64:64-n32:64-S128"
target triple = "armv7-pc-none-eabi"

define void @top() {
  store volatile float {EXPRESSION}, {PTR_FLOAT} inttoptr (
      i64 {OUT} to {PTR_FLOAT})
  store volatile i32 305419896, {PTR_I32} inttoptr (
      i64 {OUT1} to {PTR_I32})
  store volatile i32 2309737967, {PTR_I32} inttoptr (
      i64 {OUT2} to {PTR_I32})
  ret void
}
