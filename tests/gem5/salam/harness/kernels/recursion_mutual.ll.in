; Reject reachable recursion without banning unreachable definitions.

target datalayout = "e-m:e-p:32:32-Fi8-i64:64-v128:64:128-a:0:32-n32-S64"
target triple = "armv7-pc-none-eabi"

define i32 @count(i32 %n) {
  %done = icmp eq i32 %n, 0
  br i1 %done, label %exit, label %recurse
exit:
  ret i32 0
recurse:
  %next = sub i32 %n, 1
  %r = call i32 @other(i32 %next)
  %v = add i32 %r, 1
  ret i32 %v
}

define i32 @other(i32 %n) {
  %done = icmp eq i32 %n, 0
  br i1 %done, label %exit, label %recurse
exit:
  ret i32 0
recurse:
  %next = sub i32 %n, 1
  %r = call i32 @count(i32 %next)
  %v = add i32 %r, 1
  ret i32 %v
}

define void @top() {
  %a = call i32 @count(i32 2)
  store volatile i32 %a, {PTR_I32} inttoptr (i32 {OUT} to {PTR_I32})
  ret void
}
