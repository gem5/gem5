bazel_dep(name = "rules_python", version = "1.2.0")

bazel_dep(
    name = "buildifier_prebuilt",
    version = "8.0.1",
    dev_dependency = True,
)

new_git_repository = use_repo_rule("@bazel_tools//tools/build_defs/repo:git.bzl", "new_git_repository")

new_git_repository(
    name = "Kconfiglib",
    build_file_content = """
py_library(
    name = "kconfiglib",
    srcs = ["kconfiglib.py"],
    visibility = ["//visibility:public"],
)
""",
    commit = "061e71f7d78cb057762d88de088055361863deff",
    dev_dependency = True,
    # `cont_choice` is used exclusively by gem5 Kconfig.
    # This patch tells Kconfiglib to treat it like the vanilla `choice`.
    patch_cmds = [
        "sed -i 's/self._line = s/s = s.replace(\"cont_choice\", \"choice\"); self._line = s/' kconfiglib.py",
    ],
    remote = "https://github.com/ulfalizer/Kconfiglib.git",
)
