def template AmxDeclare {{
    class %(class_name)s : public %(base_class)s
    {
      private:
        RegId srcRegIdxArr[4];
        RegId destRegIdxArr[8];

      public:
        %(class_name)s(ExtMachInst machInst);
        Fault execute(ExecContext *, trace::InstRecord *) const override;
        std::string generateDisassembly(Addr pc,
                const loader::SymbolTable *symtab) const override;
    };
}};

def template AmxConstructor {{
    %(class_name)s::%(class_name)s(ExtMachInst machInst) :
        %(base_class)s("%(mnemonic)s", machInst, %(op_class)s)
    {
        %(set_reg_idx_arr)s;
        %(constructor)s;
    }
}};

def template AmxMemConstructor {{
    %(class_name)s::%(class_name)s(ExtMachInst machInst) :
        %(base_class)s("%(mnemonic)s", machInst, %(op_class)s)
    {
        %(set_reg_idx_arr)s;
        EmulEnv env(0, 0, machInst.opSize, machInst.addrSize,
                    machInst.stackSize);
        env.doModRM(machInst);
        if (env.base != int_reg::T0)
            setSrcRegIdx(_numSrcRegs++, env.base);
        if (env.index != int_reg::T0)
            setSrcRegIdx(_numSrcRegs++, env.index);
        %(constructor)s;
    }
}};

def template AmxExecute {{
    Fault
    %(class_name)s::execute(ExecContext *xc,
            trace::InstRecord *traceData) const
    {
        Fault fault = NoFault;
        %(code)s;
        return fault;
    }
}};

def template AmxDisassembly {{
    std::string
    %(class_name)s::generateDisassembly(
            Addr pc, const loader::SymbolTable *symtab) const
    {
        std::stringstream response;
        printMnemonic(response, mnemonic);
        return response.str();
    }
}};

def format AmxInst(code, *opt_flags) {{
    iop = InstObjParams(name, Name, 'X86ISA::X86StaticInst', code, opt_flags)
    header_output = AmxDeclare.subst(iop)
    decoder_output = AmxConstructor.subst(iop)
    decoder_output += AmxDisassembly.subst(iop)
    decode_block = BasicDecode.subst(iop)
    exec_output = AmxExecute.subst(iop)
}};

def template AmxMemDeclare {{
    class %(class_name)s : public %(base_class)s
    {
      private:
        RegId srcRegIdxArr[4];
        RegId destRegIdxArr[8];

      public:
        %(class_name)s(ExtMachInst machInst);
        Fault execute(ExecContext *, trace::InstRecord *) const override;
        Fault initiateAcc(ExecContext *,
                          trace::InstRecord *) const override;
        Fault completeAcc(PacketPtr, ExecContext *,
                          trace::InstRecord *) const override;
        std::string generateDisassembly(Addr pc,
                const loader::SymbolTable *symtab) const override;
    };
}};

def template AmxLdExecute {{
    Fault
    %(class_name)s::execute(ExecContext *xc,
            trace::InstRecord *traceData) const
    {
        Fault fault = amxRequireEnabled(xc->tcBase());
        if (fault != NoFault)
            return fault;
        fault = amxCheckEncoding(machInst, false);
        if (fault != NoFault)
            return fault;

        Addr ea = amxComputeEA(xc, this, machInst);
        uint8_t buf[AmxTileConfigBytes];
        const std::vector<bool> byte_enable(AmxTileConfigBytes, true);
        fault = xc->readMem(ea, buf, AmxTileConfigBytes, 0, byte_enable);
        if (fault != NoFault)
            return fault;
        return amxApplyTileConfig(xc->tcBase(), buf);
    }
}};

def template AmxLdInitiateAcc {{
    Fault
    %(class_name)s::initiateAcc(ExecContext *xc,
            trace::InstRecord *traceData) const
    {
        Fault fault = amxRequireEnabled(xc->tcBase());
        if (fault != NoFault)
            return fault;
        fault = amxCheckEncoding(machInst, false);
        if (fault != NoFault)
            return fault;

        Addr ea = amxComputeEA(xc, this, machInst);
        return initiateMemRead(xc, traceData, ea, AmxTileConfigBytes, 0);
    }
}};

def template AmxLdCompleteAcc {{
    Fault
    %(class_name)s::completeAcc(PacketPtr pkt, ExecContext *xc,
            trace::InstRecord *traceData) const
    {
        return amxApplyTileConfig(xc->tcBase(), pkt->getConstPtr<uint8_t>());
    }
}};

def format AmxLdTileCfgInst(*opt_flags) {{
    iop = InstObjParams(name, Name, 'X86ISA::X86StaticInst', '', opt_flags)
    header_output = AmxMemDeclare.subst(iop)
    decoder_output = AmxMemConstructor.subst(iop)
    decoder_output += AmxDisassembly.subst(iop)
    decode_block = BasicDecode.subst(iop)
    exec_output = AmxLdExecute.subst(iop)
    exec_output += AmxLdInitiateAcc.subst(iop)
    exec_output += AmxLdCompleteAcc.subst(iop)
}};

def template AmxStExecute {{
    Fault
    %(class_name)s::execute(ExecContext *xc,
            trace::InstRecord *traceData) const
    {
        Fault fault = amxRequireEnabled(xc->tcBase());
        if (fault != NoFault)
            return fault;
        fault = amxCheckEncoding(machInst, false);
        if (fault != NoFault)
            return fault;

        Addr ea = amxComputeEA(xc, this, machInst);
        uint8_t buf[AmxTileConfigBytes] = {};
        amxStoreTileConfig(xc->tcBase(), buf);
        const std::vector<bool> byte_enable(AmxTileConfigBytes, true);
        return xc->writeMem(buf, AmxTileConfigBytes, ea, 0, nullptr,
                            byte_enable);
    }
}};

def template AmxStInitiateAcc {{
    Fault
    %(class_name)s::initiateAcc(ExecContext *xc,
            trace::InstRecord *traceData) const
    {
        Fault fault = amxRequireEnabled(xc->tcBase());
        if (fault != NoFault)
            return fault;
        fault = amxCheckEncoding(machInst, false);
        if (fault != NoFault)
            return fault;

        Addr ea = amxComputeEA(xc, this, machInst);
        uint8_t buf[AmxTileConfigBytes] = {};
        amxStoreTileConfig(xc->tcBase(), buf);
        const std::vector<bool> byte_enable(AmxTileConfigBytes, true);
        return xc->writeMem(buf, AmxTileConfigBytes, ea, 0, nullptr,
                            byte_enable);
    }
}};

def template AmxStCompleteAcc {{
    Fault
    %(class_name)s::completeAcc(PacketPtr pkt, ExecContext *xc,
            trace::InstRecord *traceData) const
    {
        return NoFault;
    }
}};

def format AmxStTileCfgInst(*opt_flags) {{
    iop = InstObjParams(name, Name, 'X86ISA::X86StaticInst', '', opt_flags)
    header_output = AmxMemDeclare.subst(iop)
    decoder_output = AmxMemConstructor.subst(iop)
    decoder_output += AmxDisassembly.subst(iop)
    decode_block = BasicDecode.subst(iop)
    exec_output = AmxStExecute.subst(iop)
    exec_output += AmxStInitiateAcc.subst(iop)
    exec_output += AmxStCompleteAcc.subst(iop)
}};
