# gem5 wrapper for googletest/googlemock
#
# Googletest ships its own CMakeLists.txt. We build gtest and gmock manually
# here to match the flags and target names used by the gem5 SCons build,
# and to avoid pulling in googletest's install/test infrastructure.

set(_gtest_dir ${CMAKE_CURRENT_LIST_DIR})

add_library(gem5_ext_gtest STATIC
    ${_gtest_dir}/googletest/src/gtest-all.cc
    ${_gtest_dir}/googletest/src/gtest_main.cc
)

target_include_directories(gem5_ext_gtest SYSTEM PUBLIC
    ${_gtest_dir}/googletest/include
    ${_gtest_dir}/googlemock/include
)

target_include_directories(gem5_ext_gtest PRIVATE
    ${_gtest_dir}/googletest
)

target_compile_options(gem5_ext_gtest PRIVATE
    -g
    -Wno-undef
)

target_compile_definitions(gem5_ext_gtest PUBLIC
    USE_GMOCK
)

target_link_libraries(gem5_ext_gtest PUBLIC
    Threads::Threads
)

set_target_properties(gem5_ext_gtest PROPERTIES
    POSITION_INDEPENDENT_CODE ON
)

add_library(gem5_ext_gmock STATIC
    ${_gtest_dir}/googlemock/src/gmock-all.cc
)

target_include_directories(gem5_ext_gmock SYSTEM PUBLIC
    ${_gtest_dir}/googlemock/include
    ${_gtest_dir}/googletest/include
)

target_include_directories(gem5_ext_gmock PRIVATE
    ${_gtest_dir}/googlemock
    ${_gtest_dir}/googletest
)

target_compile_options(gem5_ext_gmock PRIVATE
    -g
    -Wno-undef
)

target_link_libraries(gem5_ext_gmock PUBLIC
    gem5_ext_gtest
    Threads::Threads
)

set_target_properties(gem5_ext_gmock PROPERTIES
    POSITION_INDEPENDENT_CODE ON
)
