)

new_git_repository(
    name = "Kconfiglib",
    build_file_content = """
py_library(
    name = "kconfiglib",
    srcs = ["kconfiglib.py"],
    visibility = ["//visibility:public"],
)
""",
    commit = "061e71f7d78cb057762d88de088055361863deff",
    patch_cmds = [
        "sed -i 's/self._line = s/s = s.replace(\"cont_choice\", \"choice\"); self._line = s/' kconfiglib.py",
    ],
    remote = "https://github.com/ulfalizer/Kconfiglib.git",
)

