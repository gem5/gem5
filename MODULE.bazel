new_local_repository(
    name = "libelf",
    build_file_content = """
cc_library(
    name = "lib",
    srcs = glob(["*.c"]) + [
        ":libelf_convert_c",
        ":libelf_msize_c",
        ":libelf_fsize_c",
    ],
    hdrs = glob(["*.h"]) + [
        ":native_elf_format_h",
    ],
    include_prefix = ".",
    visibility = ["//visibility:public"],
)
sh_binary(
    name = "native_elf_format_sh",
    srcs = ["native-elf-format"],
)
genrule(
    name = "native_elf_format_h",
    srcs = [],
    outs = ["native-elf-format.h"],
    tools = [":native_elf_format_sh"],
    # Skipping the first (redundant) line for hermeticity to hold
    cmd = "$(execpath :native_elf_format_sh) | tail -n +2 > \\"$@\\"",
)
genrule(
    name = "libelf_convert_c",
    srcs = ["libelf_convert.m4", "elf_types.m4"],
    outs = ["libelf_convert.c"],
    cmd = "m4 -E -DSRCDIR=`dirname $(execpath :libelf_convert.m4)` $(SRCS) > \\"$@\\"",
)
genrule(
    name = "libelf_fsize_c",
    srcs = ["libelf_fsize.m4", "elf_types.m4"],
    outs = ["libelf_fsize.c"],
    cmd = "m4 -E -DSRCDIR=`dirname $(execpath :libelf_fsize.m4)` $(SRCS) > \\"$@\\"",
)
genrule(
    name = "libelf_msize_c",
    srcs = ["libelf_msize.m4", "elf_types.m4"],
    outs = ["libelf_msize.c"],
    cmd = "m4 -E -DSRCDIR=`dirname $(execpath :libelf_msize.m4)` $(SRCS) > \\"$@\\"",
)
""",
    path = "ext/libelf",
)

