{
    "name": "gem5 Workload Development Container",
    "image": "ghcr.io/gem5/devcontainer-workloads:latest",
    "remoteUser": "gem5",
    "hostRequirements": {
        "cpus": 8,
        "memory": "16gb",
        "storage": "32gb"
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "eamodio.gitlens",
                "GitHub.copilot",
                "GitHub.copilot-chat",
                "GitHub.vscode-pull-request-github",
                "ms-python.debugpy",
                "ms-python.isort",
                "ms-python.python",
                "ms-python.vscode-pylance",
                "ms-vscode.cpptools",
                "Tsinghua-Hexin-Joint-Institute.gem5-slicc"
            ],
            "settings": {
                "python.defaultInterpreterPath":
                    "${workspaceFolder}/.venv/bin/python",
                "C_Cpp.default.compileCommands":
                    "${workspaceFolder}/.devcontainer-cache/compile_commands.json"
            }
        }
    },
    "features": {
        "ghcr.io/devcontainers/features/docker-in-docker:2": {},
        "ghcr.io/devcontainers/features/github-cli:1": {},
        "ghcr.io/devcontainers-extra/features/actionlint:1": {},
        "ghcr.io/devcontainers-extra/features/vscode-cli:1": {}
    },
    "remoteEnv": {
        "PATH": "${containerWorkspaceFolder}/.venv/bin:${containerEnv:PATH}",
        "XDG_CACHE_HOME": "${containerWorkspaceFolder}/.devcontainer-cache",
        "PRE_COMMIT_HOME":
            "${containerWorkspaceFolder}/.devcontainer-cache/pre-commit",
        "CCACHE_DIR": "${containerWorkspaceFolder}/.devcontainer-cache/ccache",
        "GEM5_RESOURCE_DIR":
            "${containerWorkspaceFolder}/.devcontainer-cache/resources"
    },
    "updateContentCommand": "./.devcontainer/on-create.sh",
    "postCreateCommand":
        ".venv/bin/pre-commit install -t pre-commit -t commit-msg"
}
