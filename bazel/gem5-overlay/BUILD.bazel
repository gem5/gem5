"""Top-level BUILD file for the @gem5_sources overlay repository.

Provides the final link targets:
- gem5_all: cc_library aggregating all subsystem libraries (with alwayslink)
- gem5: cc_binary linking gem5_all with main.cc
- gem5_config_headers: generated config/*.hh headers
- gem5_switching_headers: generated arch/*.hh switching headers
"""

load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load(
    "//rules:defs.bzl",
    "gem5_config_header",
    "gem5_config_header_namespace",
    "gem5_config_header_string",
    "gem5_sim_object_aggregate",
    "gem5_simobject_pysources",
    "gem5_switching_headers",
)
load("//rules:debug_flags_all.bzl", "ALL_DEBUG_FLAGS")
load(
    "//rules:simobject_py_files.bzl",
    "SIMOBJECT_PY_FILES_ARM",
    "SIMOBJECT_PY_FILES_BASE",
    "SIMOBJECT_PY_FILES_GPU",
    "SIMOBJECT_PY_FILES_MIPS",
    "SIMOBJECT_PY_FILES_POWER",
    "SIMOBJECT_PY_FILES_RISCV",
    "SIMOBJECT_PY_FILES_RUBY",
    "SIMOBJECT_PY_FILES_RUBY_GPU",
    "SIMOBJECT_PY_FILES_SPARC",
    "SIMOBJECT_PY_FILES_X86",
    "simobject_paths_to_labels",
)

package(default_visibility = ["//visibility:public"])

exports_files(["LICENSE", "COPYING", "README.md"])

# ---------------------------------------------------------------------------
# Public API headers from include/ directory.
# Source code includes these as <gem5/asm/generic/m5ops.h> etc.
# ---------------------------------------------------------------------------
cc_library(
    name = "gem5_include_hdrs",
    hdrs = glob(["include/**/*.h"]),
    includes = ["include"],
)

