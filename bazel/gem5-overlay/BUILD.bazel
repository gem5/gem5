# ---------------------------------------------------------------------------
# Switching headers: arch/*.hh redirects to ISA-specific headers.
# Generated based on primary_isa flag value.
# ---------------------------------------------------------------------------
gem5_switching_headers(
    name = "arch_switching_headers",
    headers = [
        "decoder.hh",
        "generic/tlbi_op.hh",
        "interrupts.hh",
        "isa.hh",
        "locked_mem.hh",
        "mmu.hh",
        "page_size.hh",
        "pcstate.hh",
        "regs/float.hh",
        "regs/int.hh",
        "regs/misc.hh",
        "regs/vec.hh",
        "regs/vecpred.hh",
        "regs/matrix.hh",
        "remote_gdb.hh",
        "tlb.hh",
        "types.hh",
        "utility.hh",
        "vecregs.hh",
    ],
    isa_dir = select({
        "//configs:primary_isa_x86": "x86",
        "//configs:primary_isa_arm": "arm",
        "//configs:primary_isa_riscv": "riscv",
        "//configs:primary_isa_mips": "mips",
        "//configs:primary_isa_power": "power",
        "//configs:primary_isa_sparc": "sparc",
    }),
)

# GPU switching headers (only meaningful when GPU is enabled)
gem5_switching_headers(
    name = "gpu_switching_headers",
    headers = [
        "gpu_decoder.hh",
        "gpu_isa.hh",
        "gpu_registers.hh",
        "gpu_types.hh",
    ],
    isa_dir = "amdgpu/vega",
    output_prefix = "arch",
)

# Switching headers aggregated as a cc_library for include path propagation
cc_library(
    name = "gem5_switching_hdrs",
    hdrs = [
        ":arch_switching_headers",
        ":gpu_switching_headers",
    ],
    includes = ["."],
)

# ---------------------------------------------------------------------------
# SimObject param/enum generation: aggregate target that discovers all
# SimObject classes by importing m5.objects via gem5py_m5 and generates
# params/*.hh, enums/*.hh, enums/*.cc, python/_m5/param_*.cc.
# ---------------------------------------------------------------------------
_SIMOBJ_PY_FILES = SIMOBJECT_PY_FILES_BASE + select({
    "//configs:x86_isa_enabled": SIMOBJECT_PY_FILES_X86,
    "//conditions:default": [],
}) + select({
    "//configs:arm_isa_enabled": SIMOBJECT_PY_FILES_ARM,
    "//conditions:default": [],
}) + select({
    "//configs:mips_isa_enabled": SIMOBJECT_PY_FILES_MIPS,
    "//conditions:default": [],
}) + select({
    "//configs:power_isa_enabled": SIMOBJECT_PY_FILES_POWER,
    "//conditions:default": [],
}) + select({
    "//configs:riscv_isa_enabled": SIMOBJECT_PY_FILES_RISCV,
    "//conditions:default": [],
}) + select({
    "//configs:sparc_isa_enabled": SIMOBJECT_PY_FILES_SPARC,
    "//conditions:default": [],
}) + select({
    "//configs:gpu_enabled": SIMOBJECT_PY_FILES_GPU,
    "//conditions:default": [],
}) + select({
    "//configs:ruby_enabled": SIMOBJECT_PY_FILES_RUBY,
    "//conditions:default": [],
}) + select({
    "//configs:ruby_gpu_enabled": SIMOBJECT_PY_FILES_RUBY_GPU,
    "//conditions:default": [],
