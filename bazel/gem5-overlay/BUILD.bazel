"""Top-level BUILD file for the @gem5_sources overlay repository.

Provides the final link targets:
- gem5_all: cc_library aggregating all subsystem libraries (with alwayslink)
- gem5: cc_binary linking gem5_all with main.cc
- gem5_config_headers: generated config/*.hh headers
- gem5_switching_headers: generated arch/*.hh switching headers
"""

load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load(
    "//rules:defs.bzl",
    "gem5_config_header",
    "gem5_config_header_namespace",
    "gem5_config_header_string",
    "gem5_sim_object_aggregate",
    "gem5_switching_headers",
)

package(default_visibility = ["//visibility:public"])

exports_files(["LICENSE"])

# ---------------------------------------------------------------------------
# Config headers: generated config/*.hh files matching CMake's Kconfig output.
# Source code includes these as #include "config/have_png.hh" etc.
# ---------------------------------------------------------------------------

# Boolean config headers (flag-dependent via select())
gem5_config_header(
    name = "_config_have_png",
    key = "HAVE_PNG",
    value = select({
        "//configs:png_enabled": "1",
        "//conditions:default": "0",
    }),
)

