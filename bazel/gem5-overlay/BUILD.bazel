"""Top-level BUILD file for the @gem5_sources overlay repository.

Provides the final link targets:
- gem5_all: cc_library aggregating all subsystem libraries (with alwayslink)
- gem5: cc_binary linking gem5_all with main.cc
"""

load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")

package(default_visibility = ["//visibility:public"])

exports_files(["LICENSE"])

# ---------------------------------------------------------------------------
# gem5_all: Aggregation library that links all subsystem libraries.
#
# This mirrors CMake's gem5_all STATIC library. All subsystem cc_libraries
# use alwayslink=True to ensure SimObject factories, EmbeddedPython
# registrations, and static initializers are retained during linking.
# ---------------------------------------------------------------------------
cc_library(
    name = "gem5_all",
    deps = [
        # ---- Core subsystems (always built) ----
        "//src/base:base",
        "//src/sim:sim",
        "//src/mem:mem",
        "//src/cpu:cpu",
        "//src/dev:dev",
        "//src/kern:kern",
        "//src/arch/generic:generic",
        "//src/sst:sst",
        "//src/learning_gem5/part2:learning",

        # ---- Global ext/ libs (pervasively used) ----
        "@gem5_ext_fputils//:fputils",
        "@gem5_ext_iostream3//:iostream3",
        "@gem5_ext_magic_enum//:magic_enum",
        "@gem5_ext_softfloat//:softfloat",
    ] + select({
        # ---- ISA-conditional architecture libraries ----
        "//configs:x86_isa_enabled": ["//src/arch/x86:x86"],
        "//conditions:default": [],
    }) + select({
        "//configs:arm_isa_enabled": ["//src/arch/arm:arm"],
        "//conditions:default": [],
    }) + select({
        "//configs:riscv_isa_enabled": ["//src/arch/riscv:riscv"],
        "//conditions:default": [],
    }) + select({
        "//configs:mips_isa_enabled": ["//src/arch/mips:mips"],
        "//conditions:default": [],
    }) + select({
        "//configs:power_isa_enabled": ["//src/arch/power:power"],
        "//conditions:default": [],
    }) + select({
        "//configs:sparc_isa_enabled": ["//src/arch/sparc:sparc"],
        "//conditions:default": [],
    }) + select({
        # ---- ISA-conditional device libraries ----
        "//configs:arm_isa_enabled": ["//src/dev/arm:dev_arm"],
        "//conditions:default": [],
    }) + select({
        "//configs:x86_isa_enabled": ["//src/dev/x86:dev_x86"],
        "//conditions:default": [],
    }) + select({
        "//configs:riscv_isa_enabled": ["//src/dev/riscv:dev_riscv"],
        "//conditions:default": [],
    }) + select({
        "//configs:mips_isa_enabled": ["//src/dev/mips:dev_mips"],
        "//conditions:default": [],
    }) + select({
        "//configs:sparc_isa_enabled": ["//src/dev/sparc:dev_sparc"],
        "//conditions:default": [],
    }) + select({
        # ---- Feature-conditional subsystems ----
        "//configs:ruby_enabled": ["//src/mem/ruby:ruby"],
        "//conditions:default": [],
    }) + select({
        "//configs:protobuf_enabled": ["//src/proto:proto"],
        "//conditions:default": [],
    }) + select({
        "//configs:gpu_enabled": [
            "//src/gpu-compute:gpu_compute",
            "//src/arch/amdgpu:amdgpu",
            "//src/dev/hsa:dev_hsa",
            "//src/dev/amdgpu:dev_amdgpu",
        ],
        "//conditions:default": [],
    }) + select({
        "//configs:systemc_enabled": ["//src/systemc:systemc"],
        "//conditions:default": [],
    }) + select({
        "//configs:test_objects_enabled": ["//src/test_objects:test_objects"],
        "//conditions:default": [],
    }) + select({
        "//configs:python_enabled": ["//src/python:python"],
        "//conditions:default": [],
    }),
    linkopts = [
        "-lz",
        "-lpthread",
        "-lrt",
    ],
    alwayslink = True,
)

# ---------------------------------------------------------------------------
# gem5: The gem5 simulator binary.
# ---------------------------------------------------------------------------
cc_binary(
    name = "gem5",
    srcs = ["//src/sim:main_cc"],
    deps = [":gem5_all"],
    linkopts = select({
        "//configs:python_enabled": ["-ldl", "-lutil"],
        "//conditions:default": [],
    }),
)

