# SLICC-generated SimObject .py files for the active protocol.
# These are fed into the aggregate param generator so that SLICC controller
# SimObjects (L1Cache_Controller, Directory_Controller, etc.) get params headers.
# Uses protocol select directly (ruby_protocol always has a value; when Ruby
# is disabled, the SLICC .py files are harmless extra params).
_SLICC_PY_SRCS = select({
    "//configs:protocol_mesi_two_level": ["//src/mem/ruby/protocol:MESI_Two_Level_py"],
    "//configs:protocol_mesi_three_level": ["//src/mem/ruby/protocol:MESI_Three_Level_py"],
    "//configs:protocol_mesi_three_level_htm": ["//src/mem/ruby/protocol:MESI_Three_Level_HTM_py"],
    "//configs:protocol_mi_example": ["//src/mem/ruby/protocol:MI_example_py"],
    "//configs:protocol_moesi_amd_base": ["//src/mem/ruby/protocol:MOESI_AMD_Base_py"],
    "//configs:protocol_moesi_cmp_directory": ["//src/mem/ruby/protocol:MOESI_CMP_directory_py"],
    "//configs:protocol_moesi_cmp_token": ["//src/mem/ruby/protocol:MOESI_CMP_token_py"],
    "//configs:protocol_moesi_hammer": ["//src/mem/ruby/protocol:MOESI_hammer_py"],
    "//configs:protocol_chi": ["//src/mem/ruby/protocol:CHI_py"],
    "//configs:protocol_gpu_viper": ["//src/mem/ruby/protocol:GPU_VIPER_py"],
    "//configs:protocol_gpu_viper_region": ["//src/mem/ruby/protocol:GPU_VIPER_py"],
    "//configs:protocol_garnet_standalone": ["//src/mem/ruby/protocol:Garnet_standalone_py"],
    "//configs:protocol_multiple": [
        "//src/mem/ruby/protocol:MESI_Two_Level_py",
        "//src/mem/ruby/protocol:MESI_Three_Level_py",
        "//src/mem/ruby/protocol:MESI_Three_Level_HTM_py",
        "//src/mem/ruby/protocol:MI_example_py",
        "//src/mem/ruby/protocol:MOESI_AMD_Base_py",
        "//src/mem/ruby/protocol:MOESI_CMP_directory_py",
        "//src/mem/ruby/protocol:MOESI_CMP_token_py",
        "//src/mem/ruby/protocol:MOESI_hammer_py",
        "//src/mem/ruby/protocol:CHI_py",
        "//src/mem/ruby/protocol:GPU_VIPER_py",
        "//src/mem/ruby/protocol:Garnet_standalone_py",
    ],
    "//conditions:default": [],
})

gem5_sim_object_aggregate(
    name = "sim_object_params",
    gem5py_m5 = "//src/python:gem5py_m5",
    use_python = select({
        "//configs:python_enabled": True,
        "//conditions:default": False,
    }),
    simobject_py_files = _SIMOBJ_PY_FILES,
    simobject_py_srcs = _SIMOBJ_PY_SRCS,
    generated_simobject_py_srcs = _SLICC_PY_SRCS,
    # Header-only deps: enough for #include "params/*.hh" and "enums/*.hh"
    deps = [
        ":gem5_config_headers",
        "//src:_gem5_base_hdrs",
    ],
    # Compiled deps: the generated .cc files include sim/sim_object.hh and
    # other deep headers that transitively pull in debug/*.hh. Provide
    # _gem5_base_hdrs (source headers), all debug flags, pybind11, and Python.
    compiled_deps = [
        "//src:_gem5_base_hdrs",
        ":gem5_config_headers",
        "@gem5_ext_pybind11//:pybind11",
        "@system_python//:python",
    ] + ALL_DEBUG_FLAGS + select({
        "//configs:ruby_enabled": [
            "//src/mem/ruby:ruby",
            "//src/mem/ruby/protocol:active_protocol",
        ],
        "//conditions:default": [],
    }),
)

