}) + select({
    "//configs:gpu_enabled": simobject_paths_to_labels(SIMOBJECT_PY_FILES_GPU),
    "//conditions:default": [],
}) + select({
    "//configs:ruby_enabled": simobject_paths_to_labels(SIMOBJECT_PY_FILES_RUBY),
    "//conditions:default": [],
}) + select({
    "//configs:ruby_gpu_enabled": simobject_paths_to_labels(SIMOBJECT_PY_FILES_RUBY_GPU),
    "//conditions:default": [],
