}) + select({
    "//configs:power_isa_enabled": simobject_paths_to_labels(SIMOBJECT_PY_FILES_POWER),
    "//conditions:default": [],
}) + select({
    "//configs:riscv_isa_enabled": simobject_paths_to_labels(SIMOBJECT_PY_FILES_RISCV),
    "//conditions:default": [],
}) + select({
    "//configs:sparc_isa_enabled": simobject_paths_to_labels(SIMOBJECT_PY_FILES_SPARC),
