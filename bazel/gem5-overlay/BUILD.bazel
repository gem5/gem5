# Aggregation library providing all config headers with proper include path.
# This is depended on by gem5_hdrs to make config/ headers available globally.
cc_library(
    name = "gem5_config_headers",
    hdrs = [
        ":_config_have_png",
        ":_config_have_protobuf",
        ":_config_have_hdf5",
        ":_config_have_tuntap",
        ":_config_have_fenv",
        ":_config_have_valgrind",
        ":_config_build_gpu",
        ":_config_use_kvm",
        ":_config_use_posix_clock",
        ":_config_have_deprecated_namespace",
        ":_config_have_perf_attr_exclude_host",
        ":_config_kvm_isa",
        ":_config_the_gpu_isa",
        ":_config_use_x86_isa",
        ":_config_use_arm_isa",
        ":_config_use_riscv_isa",
        ":_config_use_sparc_isa",
        ":_config_use_mips_isa",
        ":_config_use_power_isa",
        ":_config_ruby",
        ":_config_protocol",
    ],
    includes = ["."],
)

# ---------------------------------------------------------------------------
# Switching headers: arch/*.hh redirects to ISA-specific headers.
# Generated based on primary_isa flag value.
# ---------------------------------------------------------------------------
gem5_switching_headers(
    name = "arch_switching_headers",
    headers = [
        "decoder.hh",
        "generic/tlbi_op.hh",
        "interrupts.hh",
        "isa.hh",
        "locked_mem.hh",
        "mmu.hh",
        "page_size.hh",
        "pcstate.hh",
        "regs/float.hh",
        "regs/int.hh",
        "regs/misc.hh",
        "regs/vec.hh",
        "regs/vecpred.hh",
        "regs/matrix.hh",
        "remote_gdb.hh",
        "tlb.hh",
        "types.hh",
        "utility.hh",
        "vecregs.hh",
    ],
    isa_dir = select({
        "//configs:primary_isa_x86": "x86",
        "//configs:primary_isa_arm": "arm",
        "//configs:primary_isa_riscv": "riscv",
        "//configs:primary_isa_mips": "mips",
        "//configs:primary_isa_power": "power",
        "//configs:primary_isa_sparc": "sparc",
    }),
)

# GPU switching headers (only meaningful when GPU is enabled)
gem5_switching_headers(
    name = "gpu_switching_headers",
    headers = [
        "gpu_decoder.hh",
        "gpu_isa.hh",
        "gpu_registers.hh",
        "gpu_types.hh",
    ],
    isa_dir = "amdgpu/vega",
    output_prefix = "arch",
)

# Switching headers aggregated as a cc_library for include path propagation
cc_library(
    name = "gem5_switching_hdrs",
    hdrs = [
        ":arch_switching_headers",
        ":gpu_switching_headers",
    ],
    includes = ["."],
)

# ---------------------------------------------------------------------------
# SimObject param/enum generation: aggregate target that discovers all
# SimObject classes by importing m5.objects via gem5py_m5 and generates
# params/*.hh, enums/*.hh, enums/*.cc, python/_m5/param_*.cc.
# ---------------------------------------------------------------------------
gem5_sim_object_aggregate(
    name = "sim_object_params",
    gem5py_m5 = "//src/python:gem5py_m5",
    use_python = select({
        "//configs:python_enabled": True,
        "//conditions:default": False,
    }),
    deps = [
        ":gem5_config_headers",
        "//src:_gem5_base_hdrs",
        "@gem5_ext_pybind11//:pybind11",
        "@system_python//:python",
    ],
)

# ---------------------------------------------------------------------------
# gem5_all: Aggregation library that links all subsystem libraries.
#
# This mirrors CMake's gem5_all STATIC library. All subsystem cc_libraries
# use alwayslink=True to ensure SimObject factories, EmbeddedPython
# registrations, and static initializers are retained during linking.
# ---------------------------------------------------------------------------
cc_library(
    name = "gem5_all",
    deps = [
        # ---- Core subsystems (always built) ----
        "//src/base:base",
        "//src/sim:sim",
        "//src/mem:mem",
        "//src/cpu:cpu",
        "//src/dev:dev",
        "//src/kern:kern",
        "//src/arch/generic:generic",
        "//src/sst:sst",
        "//src/learning_gem5/part2:learning",

        # ---- Generated SimObject params and enums ----
        "//:sim_object_params",

        # ---- Global ext/ libs (pervasively used) ----
        "@gem5_ext_fputils//:fputils",
        "@gem5_ext_iostream3//:iostream3",
        "@gem5_ext_magic_enum//:magic_enum",
        "@gem5_ext_softfloat//:softfloat",
    ] + select({
        # ---- ISA-conditional architecture libraries ----
        "//configs:x86_isa_enabled": ["//src/arch/x86:x86"],
        "//conditions:default": [],
    }) + select({
        "//configs:arm_isa_enabled": ["//src/arch/arm:arm"],
        "//conditions:default": [],
    }) + select({
        "//configs:riscv_isa_enabled": ["//src/arch/riscv:riscv"],
        "//conditions:default": [],
    }) + select({
        "//configs:mips_isa_enabled": ["//src/arch/mips:mips"],
        "//conditions:default": [],
    }) + select({
        "//configs:power_isa_enabled": ["//src/arch/power:power"],
        "//conditions:default": [],
    }) + select({
        "//configs:sparc_isa_enabled": ["//src/arch/sparc:sparc"],
        "//conditions:default": [],
    }) + select({
        # ---- ISA-conditional device libraries ----
        "//configs:arm_isa_enabled": ["//src/dev/arm:dev_arm"],
        "//conditions:default": [],
    }) + select({
        "//configs:x86_isa_enabled": ["//src/dev/x86:dev_x86"],
        "//conditions:default": [],
    }) + select({
        "//configs:riscv_isa_enabled": ["//src/dev/riscv:dev_riscv"],
        "//conditions:default": [],
    }) + select({
        "//configs:mips_isa_enabled": ["//src/dev/mips:dev_mips"],
        "//conditions:default": [],
    }) + select({
        "//configs:sparc_isa_enabled": ["//src/dev/sparc:dev_sparc"],
        "//conditions:default": [],
    }) + select({
        # ---- Feature-conditional subsystems ----
        "//configs:ruby_enabled": ["//src/mem/ruby:ruby"],
        "//conditions:default": [],
    }) + select({
        "//configs:protobuf_enabled": ["//src/proto:proto"],
        "//conditions:default": [],
    }) + select({
        "//configs:gpu_enabled": [
            "//src/gpu-compute:gpu_compute",
            "//src/arch/amdgpu:amdgpu",
            "//src/dev/hsa:dev_hsa",
            "//src/dev/amdgpu:dev_amdgpu",
        ],
        "//conditions:default": [],
    }) + select({
        "//configs:tlm_enabled": [
            "//src/mem/ruby/protocol/chi/tlm:chi_tlm",
            "//src/mem/ruby/protocol/chi/tlm:chi_tlm_simobjects",
            "//src/mem/ruby/protocol/chi/tlm:chi_tlm_pysources",
        ],
        "//conditions:default": [],
    }) + select({
        "//configs:systemc_enabled": ["//src/systemc:systemc"],
        "//conditions:default": [],
    }) + select({
        "//configs:test_objects_enabled": ["//src/test_objects:test_objects"],
        "//conditions:default": [],
    }) + select({
        "//configs:python_enabled": [
            "//src/python:python",
            "//src/python:pysources",
            "//src/python:importer_code",
            "//src/python:defines_pysource",
        ],
        "//conditions:default": [],
    }),
    linkopts = [
        "-lz",
        "-lpthread",
        "-lrt",
    ],
    alwayslink = True,
)

# ---------------------------------------------------------------------------
# gem5: The gem5 simulator binary.
# ---------------------------------------------------------------------------
cc_binary(
    name = "gem5",
    srcs = ["//src/sim:main_cc"],
    deps = [":gem5_all"],
    linkopts = select({
        "//configs:python_enabled": ["-ldl", "-lutil"],
        "//conditions:default": [],
    }),
)

