"""BUILD file for src/proto/ -- gem5 protobuf definitions.

Provides pre-compiled protobuf message wrappers (packet_msg.cc, etc.)
and the trace reader/writer infrastructure.
Conditionally included when //configs:protobuf_enabled is True.
"""

load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "hdrs_files",
    srcs = glob(["*.hh"]),
)

cc_library(
    name = "proto",
    srcs = glob(["*.cc"], exclude = ["**/*.test.cc"]),
    hdrs = glob(["*.hh"]),
    includes = ["."],
    deps = [
        "//src:gem5_hdrs",
        "@protobuf//:protobuf",
    ],
    alwayslink = True,
)
