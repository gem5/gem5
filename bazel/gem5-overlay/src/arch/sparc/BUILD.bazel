"""BUILD file for src/arch/sparc/ -- SPARC ISA implementation."""

load("@rules_cc//cc:defs.bzl", "cc_library")
load("//rules:defs.bzl", "gem5_debug_flag", "gem5_isa_desc")

package(default_visibility = ["//visibility:public"])

# -- Header filegroup for gem5_hdrs aggregation --
filegroup(
    name = "hdrs_files",
    srcs = glob(["*.hh", "insts/*.hh", "linux/*.hh", "regs/*.hh"]),
)

gem5_isa_desc(
    name = "sparc_isa_desc",
    desc = "isa/main.isa",
    isa_sources = glob(["isa/**/*.isa"]),
    deps = ["//src:gem5_hdrs"],
)

gem5_debug_flag(name = "Sparc", desc = "SPARC ISA debugging")
gem5_debug_flag(name = "RegisterWindows", desc = "Register window manipulation")

cc_library(
    name = "sparc",
    srcs = glob(["*.cc", "insts/*.cc", "linux/*.cc", "regs/*.cc"], exclude = ["**/*.test.cc"]),
    hdrs = glob(["*.hh", "insts/*.hh", "linux/*.hh", "regs/*.hh"]),
    includes = ["."],
    deps = [
        "//src:gem5_hdrs",
        "//src/arch:Decoder",
        "//src/arch:Faults",
        "//src/arch/generic:generic",
        ":sparc_isa_desc",
        ":RegisterWindows",
        ":Sparc",
    ],
    alwayslink = True,
)
