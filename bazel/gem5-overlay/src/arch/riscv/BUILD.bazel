"""BUILD file for src/arch/riscv/ -- RISC-V ISA implementation.

Conditionally included when //configs:riscv_isa_enabled is True.
ISA parser: decoder_splits=1, exec_splits=1.
"""

load("@rules_cc//cc:defs.bzl", "cc_library")
load("//rules:defs.bzl", "gem5_debug_flag")

package(default_visibility = ["//visibility:public"])

# -- Header filegroup for gem5_hdrs aggregation --
filegroup(
    name = "hdrs_files",
    srcs = glob([
        "*.hh",
        "bare_metal/*.hh",
        "insts/*.hh",
        "linux/*.hh",
    ]),
)

gem5_debug_flag(name = "RiscvMisc", desc = "RISC-V miscellaneous debugging")
gem5_debug_flag(name = "PMP", desc = "PMP debugging")

cc_library(
    name = "riscv",
    srcs = glob(
        [
            "*.cc",
            "bare_metal/*.cc",
            "insts/*.cc",
            "linux/*.cc",
        ],
        exclude = ["**/*.test.cc"],
    ),
    hdrs = glob([
        "*.hh",
        "bare_metal/*.hh",
        "insts/*.hh",
        "linux/*.hh",
    ]),
    includes = ["."],
    deps = [
        "//src:gem5_hdrs",
        "//src/arch:Decoder",
        "//src/arch:Faults",
        "//src/arch/generic:generic",
        ":PMP",
        ":RiscvMisc",
    ],
    alwayslink = True,
)
