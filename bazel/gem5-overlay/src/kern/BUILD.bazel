"""BUILD file for src/kern/ -- gem5 kernel interface library.

Provides OS-specific kernel event handlers and syscall interface implementations
for Linux, FreeBSD, and Solaris guest operating systems.
"""

load("@rules_cc//cc:defs.bzl", "cc_library")
load("//rules:defs.bzl", "gem5_debug_flag")

package(default_visibility = ["//visibility:public"])

# -- Header filegroup for gem5_hdrs aggregation --
filegroup(
    name = "hdrs_files",
    srcs = glob([
        "*.hh",
        "freebsd/*.hh",
        "linux/*.hh",
        "solaris/*.hh",
    ]),
)

# -- Debug flags --
gem5_debug_flag(name = "DebugPrintf", desc = "DebugPrintf debugging")
gem5_debug_flag(name = "Printf", desc = "Printf debugging")

# linux.cc creates a file-scope static Random instance for /dev/urandom
# emulation. Kept in a separate target (no alwayslink) so tests that
# link against gem5_all don't get an unwanted Random created at static
# init. CMake avoids this because gem5_all is linked without
# --whole-archive for tests; linux.cc is only pulled in when Linux
# class symbols are actually referenced.
cc_library(
    name = "kern_linux_random",
    srcs = ["linux/linux.cc"],
    hdrs = glob([
        "*.hh",
        "linux/*.hh",
    ]),
    includes = ["."],
    deps = [
        "//src:gem5_hdrs",
        "//src/base:base",
        "//src/sim:sim",
    ],
)

# -- Main kern library --
cc_library(
    name = "kern",
    srcs = [
        "freebsd/events.cc",
        "linux/events.cc",
        "linux/helpers.cc",
        "linux/printk.cc",
        "operatingsystem.cc",
        "system_events.cc",
    ],
    hdrs = glob([
        "*.hh",
        "freebsd/*.hh",
        "linux/*.hh",
        "solaris/*.hh",
    ]),
    includes = ["."],
    deps = [
        "//src:gem5_hdrs",
        "//src/base:base",
        "//src/sim:sim",
        ":kern_linux_random",
        ":DebugPrintf",
        ":Printf",
    ],
    alwayslink = True,
)
